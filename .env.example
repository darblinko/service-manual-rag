# Copy to .env and fill in only what you use. Every value here is optional.

# auto: OpenAI when OPENAI_API_KEY is set, otherwise offline.
# offline: hashing embedder, extractive answers, lexical judge; no network.
# openai: require OPENAI_API_KEY.
LLM_MODE=auto

OPENAI_API_KEY=
# Chat model for answers, agents, entity extraction and the LLM judge. The code sets
# temperature on each call, which reasoning models such as the GPT-5 family reject.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# Vision model for the diagnostic agent (agents extra).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cross-encoder for the agents' re-ranker; used only when sentence-transformers is installed.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# local: embedded Qdrant under QDRANT_LOCAL_PATH. server: QDRANT_HOST and QDRANT_PORT.
QDRANT_MODE=local
QDRANT_LOCAL_PATH=data/qdrant_local
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=service_manuals

# Knowledge graph search needs a running Neo4j (docker compose up neo4j).
GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# vector, graph or fused. graph needs GRAPH_ENABLED=true; fused falls back to vector without it.
RETRIEVAL_MODE=fused

# Unstructured strategy for PDF manuals (pdf extra). hi_res downloads a layout model on
# first use and infers tables; fast reads the text layer only.
PDF_STRATEGY=hi_res

# Comma-separated OEM names the agents recognize in questions.
KNOWN_OEMS=ExampleCo

LOG_LEVEL=INFO
